# Node
node_modules/
dist/
build/
out/
coverage/
*.log
.pnpm-store/

# Next.js — .next/ is the build, next-env.d.ts is regenerated by every
# `next dev`/`next build` and must not be hand-edited.
.next/
next-env.d.ts
*.tsbuildinfo

# Turborepo
.turbo/

# Env
.env
.env.*
!.env.example

# Flutter
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies

# Generated API clients (docs/decisions/001-api-client-generation.md).
# openapi.json is the committed source of truth; everything derived from it
# is regenerated by `pnpm gen:api` and never hand-edited.
packages/shared-types/src/types.generated.ts
packages/shared-types/dart/**/*.g.dart
packages/shared-types/dart/.dart_tool/
packages/shared-types/dart/.packages
packages/shared-types/dart/build/
packages/shared-types/dart/pubspec.lock

# Docker volumes / local uploads (STORAGE_LOCAL_PATH=./storage/uploads,
# relative to wherever the API runs). Anchored on purpose: a bare `storage/`
# also matches source directories named storage (apps/api/src/storage,
# apps/mobile/lib/core/storage) and silently drops them from the repo.
/storage/
/apps/api/storage/

# OS
.DS_Store
# Claude Code: personal, machine-local settings (shared ones go in .claude/settings.json).
.claude/settings.local.json
