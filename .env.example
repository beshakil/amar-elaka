NODE_ENV=development
PORT=3000

# Postgres (PostGIS) — matches infra/docker-compose.dev.yml
#
# Three roles, on purpose (docs/decisions/019-row-level-security.md):
#   ae_dev       superuser. Creates extensions, bootstraps roles, resets the
#                test database. Never used by the running API.
#   ae_migrator  owns the schema and runs migrations.
#   ae_app       what the API connects as: no ownership, no BYPASSRLS, so
#                row-level security actually applies. The API refuses to boot
#                if DATABASE_URL points at a privileged role.
#
# Passwords for the two managed roles; `make db-roles` / `make db-roles-test`
# read them from here and create or rotate the roles.
DB_APP_PASSWORD=ae_app_pass
DB_MIGRATOR_PASSWORD=ae_migrator_pass

DATABASE_URL=postgresql://ae_app:ae_app_pass@localhost:5432/amar_elaka
# Migrations run as the schema owner. Migrations 0000-0002 need the superuser
# (0000 creates extensions, 0002 reassigns ownership); 0003+ run as ae_migrator.
MIGRATION_DATABASE_URL=postgresql://ae_migrator:ae_migrator_pass@localhost:5432/amar_elaka
# `pnpm --filter api db:reset` only: drops and recreates the public schema
# before re-migrating, which needs the superuser (matches docker-compose.dev.yml's
# POSTGRES_USER/PASSWORD). Never used by the running API.
DEV_SUPERUSER_DATABASE_URL=postgresql://ae_dev:ae_dev_pass@localhost:5432/amar_elaka
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_PREPARE=true
DB_TX_MAX_RETRIES=3

# Separate test database (never the dev one), used by `pnpm test:db`.
# Create it once: CREATE DATABASE amar_elaka_test; then `make db-roles-test`.
# The suite needs all three roles: the superuser resets and migrates, ae_app
# runs the assertions (so RLS is exercised), ae_migrator proves FORCE RLS
# binds the owner too.
TEST_DATABASE_URL=postgresql://ae_dev:ae_dev_pass@localhost:5432/amar_elaka_test
TEST_APP_DATABASE_URL=postgresql://ae_app:ae_app_pass@localhost:5432/amar_elaka_test
TEST_MIGRATOR_DATABASE_URL=postgresql://ae_migrator:ae_migrator_pass@localhost:5432/amar_elaka_test

# Redis — matches infra/docker-compose.dev.yml
REDIS_URL=redis://localhost:6379

# Settings cache (apps/api/src/settings). Business numbers live in
# platform_settings, never here — these only tune the cache itself.
SETTINGS_CACHE_TTL_MS=60000
SETTINGS_SOURCE_TIMEOUT_MS=2000

# Meilisearch — matches infra/docker-compose.dev.yml
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ae_dev_meili_master_key_change_me
# Optional: prefix for index names (posts, stores, places) when environments share a server
MEILI_INDEX_PREFIX=

# Geocoding (Barikoi). Leave empty in dev: geocoding then degrades to coordinates
# and our own area data instead of calling the paid API.
BARIKOI_API_KEY=

# Object storage — any S3-compatible provider (ADR 027): Contabo Object
# Storage now, Backblaze B2 later. There is no local MinIO; dev uses its own
# *-dev buckets on the real provider. Check a setup with:
#   pnpm --filter @amar-elaka/api storage:check --origin http://localhost:3001
#
# STORAGE_PUBLIC_URL is the media bucket's PUBLIC link, not the S3 endpoint:
#   Contabo: the bucket's public-sharing link, https://<region>.contabostorage.com/<account-hash>:<bucket>
#   B2:      https://f<NNN>.backblazeb2.com/file/<bucket>  (or a CDN in front)
# The documents bucket stays private (no public sharing).
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_URL=https://sin1.contabostorage.com/<account-hash>:amar-elaka-media-dev
# Contabo regions: sin1 (Singapore, nearest to BD), eu2, usc1.
S3_ENDPOINT=https://sin1.contabostorage.com
S3_REGION=default
S3_BUCKET_MEDIA=amar-elaka-media-dev
S3_BUCKET_DOCUMENTS=amar-elaka-documents-dev
# Contabo panel → Account → Security & Access → S3 Object Storage Credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Later, Backblaze B2 (same variables, different values):
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com   e.g. s3.eu-central-003.backblazeb2.com
#   S3_REGION=<region>                               e.g. eu-central-003
#   S3_ACCESS_KEY_ID=<keyID>  S3_SECRET_ACCESS_KEY=<applicationKey>

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# SMTP — matches infra/docker-compose.dev.yml (mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@amarelaka.local

# SMS — local stub provider; set real provider credentials in prod
SMS_PROVIDER=local
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Google OAuth — audience check only, ID tokens verified locally
GOOGLE_CLIENT_ID=ae_dev_google_client_id_change_me

# Tenant resolution — base domain for subdomain lookup (mirpur.amarelaka.local -> slug "mirpur")
APP_ROOT_DOMAIN=amarelaka.local
# Infrastructure tuning, not a business rule — how long a resolved tenant is cached in Redis.
TENANT_CACHE_TTL_MS=300000
# Same treatment — how long a resolved permission set is cached in Redis.
PERMISSIONS_CACHE_TTL_MS=300000
