# Copy to .env.local. Server-only, except the NEXT_PUBLIC_FIREBASE_* block at the end.

# The API, including its version prefix.
API_BASE_URL=http://localhost:3000/api/v1

# Base domain a tenant subdomain hangs off. Locally this is `localhost`, so
# `mirpur.localhost:3001` resolves to the `mirpur` tenant (see README).
APP_ROOT_DOMAIN=localhost

# Absolute origin this site is served from, for canonical URLs and the sitemap.
SITE_ORIGIN=http://localhost:3001

# Public base URL for stored objects (tenant logos, media).
STORAGE_PUBLIC_URL=http://localhost:3000/media

# The API's public origin for the browser's chat socket (ADR 060), when it is
# not API_BASE_URL's (e.g. an internal hostname). Optional; read at runtime.
CHAT_SOCKET_URL=

# Web Push through FCM (ADR 060). Public by design (Firebase web config and
# the VAPID public key); baked in at build time. Leave empty and the site
# simply offers no push. The API's FCM_SERVICE_ACCOUNT_JSON must be the same
# Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
