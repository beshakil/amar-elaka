<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Noto Sans Bengali', 'Noto Sans', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#1a1a1a" />
    </mj-attributes>
    <mj-style>
      body {
        -webkit-text-size-adjust: 100%;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section background-color="#ffffff" padding="32px 24px" border-radius="8px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700">{{ heading }}</mj-text>
        <mj-text>{{ body }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
