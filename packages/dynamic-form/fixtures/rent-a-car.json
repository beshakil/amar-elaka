{
  "slug": "rent-a-car",
  "name": {
    "bn": "গাড়ি ভাড়া",
    "en": "Rent a Car"
  },
  "fieldSchema": {
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vehicle_type": {
          "x-field-type": "select",
          "type": "string",
          "enum": [
            "sedan",
            "microbus",
            "suv",
            "pickup",
            "coaster_bus",
            "cng",
            "motorcycle"
          ]
        },
        "brand": {
          "x-field-type": "text",
          "type": "string",
          "maxLength": 40,
          "x-analytics-safe": true
        },
        "model": {
          "x-field-type": "text",
          "type": "string",
          "maxLength": 80,
          "x-analytics-safe": true
        },
        "model_year": {
          "x-field-type": "number",
          "type": "integer",
          "minimum": 1970,
          "x-max-current-year-offset": 1
        },
        "seats": {
          "x-field-type": "number",
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "ac": {
          "x-field-type": "bool",
          "type": "boolean"
        },
        "driver_option": {
          "x-field-type": "select",
          "type": "string",
          "enum": [
            "with_driver",
            "self_drive",
            "both"
          ]
        },
        "price": {
          "x-field-type": "money",
          "type": "string",
          "x-money-min": "100.00",
          "x-money-max": "1000000.00"
        },
        "rate_per_hour": {
          "x-field-type": "money",
          "type": "string",
          "x-money-min": "10.00",
          "x-money-max": "100000.00"
        },
        "min_hours": {
          "x-field-type": "number",
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "fuel_included": {
          "x-field-type": "bool",
          "type": "boolean"
        },
        "driver_allowance_included": {
          "x-field-type": "bool",
          "type": "boolean",
          "x-show-when": {
            "field": "driver_option",
            "in": [
              "with_driver",
              "both"
            ]
          }
        },
        "outstation_allowed": {
          "x-field-type": "bool",
          "type": "boolean"
        },
        "trip_types": {
          "x-field-type": "multiselect",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local",
              "outstation",
              "airport",
              "wedding",
              "tour",
              "monthly"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "vehicle_type",
        "seats",
        "ac",
        "driver_option",
        "price"
      ]
    },
