  "info": {
    "title": "Amar Elaka API",
    "description": "Hyperlocal multi-tenant platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpSentDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "otp_sent"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{4,8}$"
          },
          "device": {
            "type": "object",
            "properties": {
              "platformCode": {
                "type": "string",
                "enum": [
                  "android",
                  "ios",
                  "web"
                ]
              },
              "appVersion": {
                "type": "string"
              },
              "deviceModel": {
                "type": "string"
              },
              "fingerprintHash": {
                "type": "string"
              },
              "pushToken": {
                "type": "string"
              }
            },
            "required": [
              "platformCode"
            ]
          }
        },
        "required": [
          "phone",
          "code",
          "device"
        ]
      },
      "SessionTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "GoogleLinkedDto": {
        "type": "object",
        "properties": {
          "linked": {
            "type": "number",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "linked"
        ]
      },
      "GoogleAuthDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "object",
            "properties": {
              "platformCode": {
                "type": "string",
                "enum": [
                  "android",
                  "ios",
                  "web"
                ]
              },
              "appVersion": {
                "type": "string"
              },
              "deviceModel": {
                "type": "string"
              },
              "fingerprintHash": {
                "type": "string"
              },
              "pushToken": {
                "type": "string"
              }
            },
            "required": [
              "platformCode"
            ]
          }
        },
        "required": [
          "idToken",
          "device"
        ]
      },
      "EmailRegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailLinkedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "linked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "EmailLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "object",
            "properties": {
              "platformCode": {
                "type": "string",
                "enum": [
                  "android",
                  "ios",
                  "web"
                ]
              },
              "appVersion": {
                "type": "string"
              },
              "deviceModel": {
                "type": "string"
              },
              "fingerprintHash": {
                "type": "string"
              },
              "pushToken": {
                "type": "string"
              }
            },
            "required": [
              "platformCode"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "device"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LoggedOutDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "logged_out"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "MeResultDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string"
          },
          "avatarStorageKey": {
            "type": "string",
            "nullable": true
          },
          "tenantId": {
            "type": "string"
          },
          "memberId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "anon",
              "member",
              "agent",
              "moderator",
              "tenant_admin",
              "partner_owner",
              "marketer",
              "executive",
              "seller",
              "platform_admin",
              "platform_support",
              "platform_finance",
              "system",
              "restricted_user",
              "appeal_public"
            ]
          }
        },
        "required": [
          "userId",
          "phone",
          "email",
          "displayName",
          "avatarStorageKey",
          "tenantId",
          "memberId",
          "role"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "avatarStorageKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "nullable": true
          }
        }
      },
      "TenantConfigDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
